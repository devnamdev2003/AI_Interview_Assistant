{
    // user service schema
    "users": {
        "id": "int",
        "password": "[Securely stored password]",
        "username": "[Unique username]",
        "first_name": "[Candidate's First Name]",
        "last_name": "[Candidate's Last Name]",
        "email": "[Candidate's Email Address]",
        "status": "active || inactive",
        "date_of_birth": "date",
        "is_registered": "true || false",
        "phone_number": "[Candidate's Phone Number]",
        "gender": "male || female || other",
        "address": "[Candidate's Address]",
        "is_verified": "true || false",
        "profile_picture_url": "[Path to Candidate's Profile Picture]",
        "last_login_date": "date",
        "time_zone": "[Candidate's Time Zone]",
        "password_last_changed_at": "date",
        "created_at": "date",
        "updated_at": "date",
        "login_attempt_count": "int",
        "role_id": "int", // Foreign Key referencing the role table
        "country_id": "int" // Foreign Key referencing the country table
    },
    "user_profiles": {
        "id": "int",
        "skills": "[Candidate's Skills]",
        "languages_spoken": "[Candidate's Languages Spoken]",
        "experience_years": "[Years of Experience]",
        "resume_file_name": "[Path to Candidate's Resume]",
        "summary": "[Candidate's Summary]",
        "social_media_links": "[Candidate's Social Media Accounts]",
        "expected_salary": "[Expected Salary]",
        "expected_job_title": "[Expected Job Title]",
        "preferred_location": "[Preferred Location]",
        "certifications": "[Candidate's Certifications]",
        "profile_completeness_percentage": "[Percentage of Profile Completeness]",
        "education_id": "int", // Foreign Key referencing the user_education table
        "user_id": "int" // Foreign Key referencing the user table
    },
    "user_auth_tokens": {
        "id": "int",
        "auth_token": "string", // Securely stored token value (e.g., hashed or encrypted)
        "created_at": "datetime", // Date and time the token was created (use datetime for precision)
        "is_expired": "boolean", // Whether the token is expired
        "last_accessed_at": "datetime", // Track when the token was last used
        "revoked_date": "datetime", // Optional: Date when the token was revoked (if applicable)
        "revoked_reason": "string", // Optional: Reason for token revocation (e.g., logout, suspicious activity)
        "token_id": "int", // Foreign Key referencing the token_details table
        "user_id": "int" // Foreign Key referencing the user table
    },
    "token_details": {
        "id": "int",
        "type": "string[refresh_token, access_token, verification_token]",
        "description": "string",
        "expiry_time": "datetime", // Expiration time of the token (use datetime for precision)
        "created_at": "datetime", // Date and time the token was created
        "updated_at": "datetime", // Date and time the token was last updated (e.g., when refreshed)
        "is_active": "boolean" // Whether the token is active or has been revoked (optional)
    },
    "user_educations": {
        "institution_name": "institution name",
        "degree_name": "degree name",
        "field_of_study": "[Field of Study]",
        "grade": "[Type of Grade (A, B, C, D, F)] or score",
        "start_date": "date",
        "end_date": "date",
        "achievements": "[Achievements]",
        "extra_details": "[Any additional details]",
        "created_at": "date",
        "updated_at": "date",
        "user_id": "int" // Foreign Key referencing the user table
    },
    "notification_settings": {
        "id": "int",
        "email_notifications_enabled": "boolean",
        "sms_notifications_enabled": "boolean",
        "push_notifications_enabled": "boolean",
        "created_at": "date",
        "user_id": "int" // Foreign Key referencing the user table
    },
    "roles": {
        "id": "int", // Unique identifier for the role
        "name": "string", // Name of the role (e.g., "admin", "user", "interviewer", "candidate")
        "description": "string", // A brief description of the role and its permissions
        "is_active": "boolean", // Whether this role is currently active and usable
        "created_at": "datetime", // Date and time when the role was created
        "updated_at": "datetime" // Date and time when the role was last updated
    },
    "permissions": {
        "id": "int",
        "name": "string", // Permission type (e.g., "edit_profile", "view_reports")
        "description": "text",
        "permission_code": "string",
        "created_at": "date"
    },
    "role_permissions": {
        "id": "int",
        "created_at": "date",
        "role_id": "int", // Foreign Key referencing the role table
        "permission_id": "int" // Foreign Key referencing the permission table
    },
